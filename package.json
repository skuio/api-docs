    "docusaurus-theme-openapi-docs": "^4.3.2",
    "path-browserify": "^1.0.1",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webpackbar": "5.0.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.0",
