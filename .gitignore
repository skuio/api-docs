# Dependencies
node_modules/

# Build output
build/
.docusaurus/

# Generated API docs (regenerated by CI via `npm run gen:api`)
docs/api/*.mdx
docs/api/*.md
docs/api/sidebar.ts
# ...and the per-operation prop sidecars the openapi theme externalizes out of
# each .api.mdx (<op>.{ParamsDetails,StatusCodes,RequestSchema,Schema,SchemaItem}.json).
# ~15,200 files, all build output: nothing reads them except the generated mdx
# that require()s them, and that mdx is itself ignored above. They were only
# ever tracked because the skuio/sku publisher bot runs `git add --all docs/api/`
# and this rule didn't exist, so every publish churned 15k files.
docs/api/*.json
# But keep the manually-written introduction
!docs/api/introduction.mdx

# Spec-generated Postman collection (~8 MB, fully derived from openapi.yaml;
# regenerated by scripts/gen-postman-collection.mjs on every build)
static/skuio-api.postman_collection.json

# Local browser-automation artifacts
.playwright-cli/
relnotes-*.png
